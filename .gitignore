.env
accounts.txt
accounts.json
instances/
auditor/data/
auditor/workspaces/
auditor/projects/
auditor/frontend/node_modules/
auditor/frontend/dist/

# Track only the auditor engine and its supporting source files.
/*
!/.gitignore
!/auditor/
/auditor/*
!/auditor/app/
!/auditor/frontend/
!/auditor/prompts/
!/auditor/runtime/
!/auditor/tests/
!/auditor/README.md
!/auditor/requirements.txt
!/auditor/*.ps1
!/auditor/*.bat
/auditor/frontend/*
!/auditor/frontend/src/
!/auditor/frontend/components.json
!/auditor/frontend/index.html
!/auditor/frontend/package.json
!/auditor/frontend/package-lock.json
!/auditor/frontend/tsconfig.json
!/auditor/frontend/vite.config.ts
__pycache__/
*.py[cod]
